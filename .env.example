# Copy to .env and fill in. Never commit .env.
# EXPO_PUBLIC_* values are bundled into the app and visible to users. No secrets here.

# Online play (Phase 2). Local stack: run `pnpm supabase start`, then copy the
# API URL and anon key from `pnpm supabase status`. Pass-and-play works without these.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me
